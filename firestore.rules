rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBookingOwner() {
      return isSignedIn() && resource.data.customer_uid == request.auth.uid;
    }

    function isBarberOwner() {
      return isSignedIn() && resource.data.barber_uid == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.customer_uid == request.auth.uid ||
        resource.data.barber_uid == request.auth.uid ||
        request.auth.token.admin == true
      );

      allow create: if isSignedIn() &&
        request.resource.data.customer_uid == request.auth.uid &&
        (request.resource.data.barber_id is int || request.resource.data.barber_id is string) &&
        request.resource.data.service_id is string &&
        request.resource.data.status == 'pending';

      allow update, delete: if isBookingOwner() || isBarberOwner();
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.barber_uid == request.auth.uid;
      allow update, delete: if isBarberOwner();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.barber_uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.barber_uid == request.auth.uid;
    }

    match /barbers/{barberId}/ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.customer_uid == request.auth.uid ||
        resource.data.barber_uid == request.auth.uid
      );
      allow create: if isSignedIn();
    }

    match /users/{userId} {
      allow read, update: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
